# 全部留空時，`npm run dev` 會進入示範模式：資料存在記憶體，登入是假的本機帳號。
# 正式環境必須五項都填，否則互動功能會關閉（不會退回示範模式）。

# Supabase > Project Settings > API
SUPABASE_URL=
# 只放伺服器端，絕對不要加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=

# LINE Developers > LINE Login channel
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=

# 用來簽登入 cookie，產生方式：openssl rand -base64 32
SESSION_SECRET=
